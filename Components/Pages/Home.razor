@page "/"
@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas id="cv"></canvas>
<button id="fsBtn" type="button" aria-label="Fullscreen">&#9974;</button>
<div id="safeAreaProbe" aria-hidden="true"></div>

@code {
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;
        await JS.InvokeVoidAsync("untGame.start");
    }

    public async ValueTask DisposeAsync()
    {
        if (!_started) return;
        _started = false;
        try
        {
            await JS.InvokeVoidAsync("untGame.stop");
        }
        catch (JSDisconnectedException)
        {
            // WebView already torn down
        }
    }
}
